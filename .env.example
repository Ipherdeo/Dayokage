# Add these values as sensitive environment variables in Vercel. Do not commit a real key.
# Use the OpenAI-compatible base URL shown in your Vyce dashboard.
VYCE_API_KEY=
VYCE_API_BASE_URL=
VYCE_MODEL=deepseek-v4-flash

# Optional but recommended: enables shared, production-grade rate limits across
# Vercel Function instances. Create a free Upstash Redis database and add both.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
